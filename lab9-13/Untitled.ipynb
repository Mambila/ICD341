   "source": [
    "import numpy as np\n",
    "import time\n",
    "\n",
    "x = np.linspace(0, 10, 1_000_000)\n",
    "\n",
    "start = time.perf_counter()\n",
    "y = x**2 + 2 * x + 1\n",
    "elapsed = time.perf_counter() - start\n",
    "\n",
    "print(f\"Vectorized result shape: {y.shape}, Time: {elapsed:.6f} s\")"
   ]
